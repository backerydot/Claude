<?xml version="1.0" encoding="utf-8"?>
<!-- Deutsch-Trainer для Android: сайт-тренер усередині застосунку
     + «охоронець», що закриває TikTok і YouTube, доки не здано урок на 1. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.deutschtrainer.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Щоб знайти на телефоні синтезатор мови для озвучки (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Охоронець: служба спеціальних можливостей, бачить, який застосунок відкрито -->
        <service
            android:name=".GuardService"
            android:label="@string/guard_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
